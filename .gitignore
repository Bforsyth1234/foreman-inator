# Claude Code (per-machine settings only; shared .claude/ files stay tracked)
.claude/settings.local.json

# OS and editors
.DS_Store
.idea/
.vscode/

# Synthetic replay fixtures are test data, not runtime data: keep them tracked.
!tests/recordings/
!tests/recordings/recordings/
!tests/recordings/traces/
